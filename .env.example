# BUILDPRO Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_BASE_URL=http://localhost:3000/api

# Database (À configurer)
DATABASE_URL=postgresql://user:password@localhost:5432/buildpro
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildpro
DB_USER=buildpro_user
DB_PASSWORD=secure_password

# Authentication (À configurer)
NEXT_PUBLIC_AUTH_ENABLED=false
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Features Flags
NEXT_PUBLIC_ENABLE_REPORTS=true
NEXT_PUBLIC_ENABLE_FINANCE=true
NEXT_PUBLIC_ENABLE_HSE=true

# Third Party Services (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# File Upload
UPLOAD_MAX_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,text/plain
UPLOAD_DIRECTORY=./uploads

# Email (For notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@buildpro.fr

# App Configuration
NEXT_PUBLIC_APP_NAME=BUILDPRO
NEXT_PUBLIC_APP_VERSION=0.1.0
NODE_ENV=development
